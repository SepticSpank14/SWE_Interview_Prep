$proc_path = 'C:\Games\GameSession\GameSession.exe'
$proc_name = 'GameSession.exe'
$ttw = 10
$logs = 'C:\Logs\session\monitor.log'
$logDir = Split-Path $log

function Get-Timestamp {
    Get-Date -Format "yyyy-mm-dd HH:mm:ss"
}

#guarded log entry, make sure file exists before writing
if (-not(Test-Path $Logs)){
    New-Item -ItemType Directory -Path $logDir -Force | Out-Null
}

#Check if proc_name is running, restart if not

while ($true){
    $results = 0
    $running_proc = Get-Process -Name $proc_name -ErrorAction SilentlyContinue
    
    if ($running_proc.count -eq 0){
        Add-Content $Logs "$(Get-Timestamp) $proc_name is not running. Attempting restart."
        $results += 1

        Start-Process -FilePath $proc_path
        Start-Sleep -Seconds 10

        if ($running_proc.count -gt 0){
            Add-Content $Logs "$(Get-Timestamp) PASS: $proc_name restarted successfully. PID: $($running_proc.Id)"
            $results = 0
        }
        elseif ($running proc.count -eq 0 and $results -eq 1){
            Add-Content $Logs "$(Get-Timestamp) CRITICAL FAILURE: $proc_name failed to start. Terminating program."
            exit 1
        }
    }
}

